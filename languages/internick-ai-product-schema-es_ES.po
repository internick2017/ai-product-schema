#. Plugin Name of the plugin
#: internick-ai-product-schema.php
msgid "Internick - AI Product Schema"
msgstr "Internick - AI Product Schema"

#. Description of the plugin
#: internick-ai-product-schema.php
msgid "Make your WooCommerce products discoverable and purchasable by AI shopping agents (complete Product schema, AI attributes, llms.txt)."
msgstr "Haz que los agentes de compra con IA puedan descubrir y comprar tus productos de WooCommerce (schema Product completo, atributos de IA, llms.txt)."

#. Author of the plugin
#: internick-ai-product-schema.php
msgid "Nick Granados"
msgstr "Nick Granados"

#. Author URI of the plugin
#: internick-ai-product-schema.php
msgid "https://nickgranados.com"
msgstr "https://nickgranados.com"

#: internick-ai-product-schema.php:88
msgid "AI Product Schema requires WooCommerce to be installed and active."
msgstr "AI Product Schema necesita que WooCommerce esté instalado y activo."

#: src/ProductFields/Fields.php:68
msgid "AI Attributes"
msgstr "Atributos de IA"

#: src/ProductFields/Fields.php:99
msgid "Product Q&amp;A"
msgstr "Preguntas y respuestas del producto"

#: src/ProductFields/Fields.php:100
msgid "Common questions and answers about this product, surfaced to AI shopping agents."
msgstr "Preguntas y respuestas habituales sobre este producto, mostradas a los agentes de compra con IA."

#: src/ProductFields/Fields.php:111
msgid "Add Q&amp;A row"
msgstr "Añadir fila de preguntas y respuestas"

#: src/ProductFields/Fields.php:117
msgid "Compatible accessories"
msgstr "Accesorios compatibles"

#: src/ProductFields/Fields.php:118
msgid "Products that work together with this one (accessories or spare parts)."
msgstr "Productos que funcionan junto con este (accesorios o repuestos)."

#: src/ProductFields/Fields.php:123
msgid "Substitute products"
msgstr "Productos sustitutos"

#: src/ProductFields/Fields.php:124
msgid "Similar products an agent can suggest when this one is unavailable."
msgstr "Productos similares que un agente puede sugerir cuando este no está disponible."

#: src/ProductFields/Fields.php:141
msgid "Question"
msgstr "Pregunta"

#: src/ProductFields/Fields.php:143
msgid "Answer"
msgstr "Respuesta"

#: src/ProductFields/Fields.php:144
msgid "Remove"
msgstr "Eliminar"

#: src/ProductFields/Fields.php:159
msgid "Search for a product&hellip;"
msgstr "Buscar un producto&hellip;"

#: src/Settings/SettingsPage.php:23
#: src/Settings/SettingsPage.php:35
msgid "AI Product Schema"
msgstr "AI Product Schema"

#: src/Settings/SettingsPage.php:37
msgid "Make your WooCommerce products discoverable and purchasable by AI shopping agents."
msgstr "Haz que los agentes de compra con IA puedan descubrir y comprar tus productos de WooCommerce."

#: src/Settings/SettingsPage.php:41
msgid "Product schema (JSON-LD)"
msgstr "Schema de producto (JSON-LD)"

#: src/Settings/SettingsPage.php:42
msgid "Output complete schema.org Product structured data on product pages."
msgstr "Muestra datos estructurados Product de schema.org completos en las páginas de producto."

#: src/Settings/SettingsPage.php:48
msgid "Serve /llms.txt"
msgstr "Servir /llms.txt"

#: src/Settings/SettingsPage.php:49
msgid "Publish a Markdown product index at /llms.txt for AI crawlers."
msgstr "Publica un índice de productos en Markdown en /llms.txt para los rastreadores de IA."

#: src/Settings/SettingsPage.php:55
msgid "AI robots.txt directives"
msgstr "Directivas de IA en robots.txt"

#: src/Settings/SettingsPage.php:56
msgid "Welcome known AI shopping crawlers in robots.txt and reference /llms.txt."
msgstr "Da la bienvenida en robots.txt a los rastreadores de compra con IA conocidos y hace referencia a /llms.txt."

#: src/Settings/SettingsPage.php:62
msgid "Schema mode"
msgstr "Modo de schema"

#: src/Settings/SettingsPage.php:63
msgid "Auto enhances the Product schema WooCommerce (or Yoast / Rank Math) already outputs. Standalone suppresses those and prints AI Product Schema's own complete Product node instead. Neither mode ever outputs a duplicate."
msgstr "Auto mejora el schema Product que WooCommerce (o Yoast / Rank Math) ya genera. Independiente los suprime e imprime en su lugar el nodo Product completo del propio AI Product Schema. Ningún modo genera nunca un duplicado."

#: src/Settings/SettingsPage.php:68
msgid "Auto (coexist with SEO plugins)"
msgstr "Auto (convivir con plugins SEO)"

#: src/Settings/SettingsPage.php:69
msgid "Always standalone"
msgstr "Siempre independiente"
